# PostFlow Development Environment Configuration Template
# NOTE: Never put secrets, API keys, or production credentials in this file or any .env file.
# PostFlow desktop derives runtime secrets via OS-backed secure credential storage (DPAPI / Windows Credential Manager).

# Backend configuration (development only)
POSTFLOW_ENV=development
POSTFLOW_HOST=127.0.0.1
POSTFLOW_PORT=0
POSTFLOW_LOG_LEVEL=INFO
